POSTGRES_DB=pipeline_crm
POSTGRES_USER=pipeline_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_PORT=5434

# Application
DB_URL=jdbc:postgresql://localhost:5434/pipeline_crm
DB_USERNAME=pipeline_user
DB_PASSWORD=change_me_strong_password

# JWT signing secret (at least 256 bits for HS256)
JWT_SECRET=change_me_super_secret_key_at_least_32_bytes_long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_COOKIE_SECURE=false

# CORS
FRONTEND_ORIGIN=http://localhost:5173
